# Public canonical URL (no trailing slash), e.g. https://www.homehub.se
NEXT_PUBLIC_SITE_URL=https://homehub.se

# Admin panel (/admin) — required for login when DB is enabled
ADMIN_USER=admin
ADMIN_PASS=change-me

# SQLite admin DB. Off by default on Vercel (VERCEL=1). Set true to force on,
# false to force off locally. Code is kept; only runtime access is gated.
# ADMIN_DB_ENABLED=false

# Optional SQLite path (default: ./data/homehub.db)
# DATABASE_PATH=/absolute/path/to/homehub.db

# Optional showroom contact overrides
# NEXT_PUBLIC_SHOWROOM_PHONE=+46812345678
# NEXT_PUBLIC_SHOWROOM_EMAIL=hello@homehub.se
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/46812345678

# Inquiry email via Resend (server-only — never commit real keys)
# Create a key at https://resend.com/api-keys — “API key is invalid” means replace it.
# EMAIL_FROM must use a domain verified in Resend (Domains), e.g. info@homehub.se
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=HOME HUB <info@your-verified-domain.com>
# Fallback recipients when Admin → Settings is empty / DB off (comma-separated)
# INQUIRY_TO_EMAIL=hello@homehub.se
