/**
 * Import Straj / Hardy Proof entrance doors from a downloaded Drive folder
 * into public/images/doors/* and generate src/data/entranceDoors.generated.ts
 *
 * Usage:
 *   npx tsx scripts/import-straj-entrance.mts [/path/to/straj-folder]
 */
import { mkdirSync, readdirSync, statSync, writeFileSync } from "node:fs";
import path from "node:path";
import sharp from "sharp";

const SRC =
  process.argv[2] ||
  "/tmp/hh-straj";
const ROOT = path.resolve(import.meta.dirname, "..");
const OUT_IMAGES = path.join(ROOT, "public/images/doors");
const OUT_TS = path.join(ROOT, "src/data/entranceDoors.generated.ts");

const IMAGE_EXT = new Set([".png", ".jpg", ".jpeg", ".webp"]);
const MIN_LARGE = 150_000;

function slugify(name: string): string {
  return name
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/&/g, " and ")
    .replace(/\+/g, " ")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .replace(/-+/g, "-");
}

function displayName(folder: string): string {
  return folder
    .replace(/\s+/g, " ")
    .replace(/\bdowble\b/gi, "double")
    .trim();
}

function pickImages(dir: string): string[] {
  const files = readdirSync(dir)
    .filter((f) => !f.startsWith("."))
    .filter((f) => IMAGE_EXT.has(path.extname(f).toLowerCase()))
    .map((f) => ({
      f,
      abs: path.join(dir, f),
      size: statSync(path.join(dir, f)).size,
      lower: f.toLowerCase(),
    }));

  const score = (x: (typeof files)[0]) => {
    let s = x.size;
    // Prefer full product shots over tiny catalog thumbs / screenshots
    if (x.lower.includes("catalog")) s -= 50_000;
    if (x.lower.includes("screenshot") || x.lower.includes("знімок")) s -= 200_000;
    if (x.lower.includes("_b") || /_b\./i.test(x.f)) s += 20_000;
    if (x.lower.includes("i_huset") || x.lower.includes("i-huset")) s += 10_000;
    return s;
  };

  const large = files.filter((x) => x.size >= MIN_LARGE).sort((a, b) => score(b) - score(a));
  const small = files.filter((x) => x.size < MIN_LARGE).sort((a, b) => score(b) - score(a));
  const chosen = (large.length ? large : small).slice(0, 5);
  return chosen.map((x) => x.abs);
}

function findOverlay(srcRoot: string): string | null {
  for (const f of readdirSync(srcRoot)) {
    if (f.startsWith(".")) continue;
    if (!IMAGE_EXT.has(path.extname(f).toLowerCase())) continue;
    if (/додавати|малюнок|всіх|всіх/i.test(f) || /add.*all|overlay/i.test(f)) {
      return path.join(srcRoot, f);
    }
  }
  // fallback: any root-level png not in a subfolder with cyrillic
  for (const f of readdirSync(srcRoot)) {
    const abs = path.join(srcRoot, f);
    if (statSync(abs).isFile() && path.extname(f).toLowerCase() === ".png" && /[а-яіїєґ]/i.test(f)) {
      return abs;
    }
  }
  return null;
}

function isDoubleOrSide(name: string): boolean {
  const n = name.toLowerCase();
  return (
    n.includes("double") ||
    n.includes("dowble") ||
    n.includes("side light") ||
    n.includes("x 2") ||
    n.includes("x2")
  );
}

async function convertToJpg(src: string, dest: string) {
  await sharp(src)
    .rotate()
    .resize({ width: 1600, height: 2200, fit: "inside", withoutEnlargement: true })
    .jpeg({ quality: 84, mozjpeg: true })
    .toFile(dest);
}

async function main() {
  const overlay = findOverlay(SRC);
  const folders = readdirSync(SRC)
    .filter((f) => !f.startsWith("."))
    .filter((f) => statSync(path.join(SRC, f)).isDirectory())
    .sort((a, b) => a.localeCompare(b));

  const entries: {
    slug: string;
    name: string;
    gallery: string[];
    priceSek: number;
  }[] = [];

  for (const folder of folders) {
    const slug = slugify(folder);
    const name = displayName(folder);
    const srcDir = path.join(SRC, folder);
    const destDir = path.join(OUT_IMAGES, slug);
    mkdirSync(destDir, { recursive: true });

    const picked = pickImages(srcDir);
    if (picked.length === 0) {
      console.warn(`skip ${folder}: no images`);
      continue;
    }

    const gallery: string[] = [];
    let n = 1;
    for (const img of picked) {
      const dest = path.join(destDir, `${String(n).padStart(2, "0")}.jpg`);
      await convertToJpg(img, dest);
      gallery.push(`/images/doors/${slug}/${String(n).padStart(2, "0")}.jpg`);
      n += 1;
    }
    if (overlay) {
      const dest = path.join(destDir, `${String(n).padStart(2, "0")}.jpg`);
      await convertToJpg(overlay, dest);
      gallery.push(`/images/doors/${slug}/${String(n).padStart(2, "0")}.jpg`);
    }

    entries.push({
      slug,
      name,
      gallery,
      priceSek: isDoubleOrSide(folder) ? 34900 : 28900,
    });
    console.log(`ok ${slug} (${gallery.length} images)`);
  }

